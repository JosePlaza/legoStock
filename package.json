{
  "name": "legostock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Registro de stock de piezas LEGO con catálogo de Pick a Brick y comparador de listas Rebrickable",
  "engines": {
    "node": ">=18.18 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=server server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
