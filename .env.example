# Copia este archivo como .env y rellena los dos valores.
# Los encuentras en Supabase → Project Settings → API (o "Connect" → App frameworks).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública "anon" (o "publishable" en proyectos nuevos). NO pongas aquí la service_role.
SUPABASE_ANON_KEY=

# Opcional
# PORT=3001

# ---- Rebrickable (búsqueda por nombre e inventarios de sets) ----
# Gratis: rebrickable.com → tu perfil → Settings → API → "Generate new API key"
REBRICKABLE_API_KEY=

# ---- BrickLink (precios de mercado) ----
# bricklink.com → My BrickLink → Settings/API (o https://www.bricklink.com/v2/api/register_consumer.page)
# Al crear el "Access Token" pon la IP 0.0.0.0 para poder usarlo desde cualquier sitio.
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN_VALUE=
BRICKLINK_TOKEN_SECRET=

# ---- BrickOwl (tiendas que venden cada set/pieza) ----
# brickowl.com → My Account → API Keys. La consulta de tiendas requiere "catalog approval" de BrickOwl.
BRICKOWL_API_KEY=

# ---- Catálogo compartido (en local y en Vercel) ----
# El mismo valor que guardaste en Supabase como secreto CATALOG_CRON_SECRET. Con él, «Actualizar ahora» e
# «Importar archivo» guardan el catálogo y su historial de cambios en Supabase.
CATALOG_CRON_SECRET=
# Correos que pueden actualizar o importar el catálogo, separados por comas.
# Si lo dejas vacío, en local puede cualquiera y en Vercel nadie.
ADMIN_EMAILS=
